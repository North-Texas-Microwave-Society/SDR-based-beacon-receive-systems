# NTMS Beacon Station Configuration — REFERENCE ONLY
# ------------------------------------------------------------
# This file documents all environment variables consumed by the
# beacon-monitor and beacon-reporter systemd services.  Actual
# configuration lives in systemd drop-in override files.
#
# To view or edit the current config on a Pi:
#   sudo systemctl edit beacon-monitor
#   sudo systemctl edit beacon-reporter
#
# The editor opens the drop-in at (create/edit and restart):
#   /etc/systemd/system/beacon-monitor.service.d/override.conf
#   /etc/systemd/system/beacon-reporter.service.d/override.conf
#
# After editing, reload and restart:
#   sudo systemctl daemon-reload
#   sudo systemctl restart beacon-monitor beacon-reporter
#
# Environment variables listed below match the [Service]
# Environment= lines in the unit and drop-in files.

# ---- Shared CSV file -------------------------------------------------------
BEACON_OUTPUT=/var/lib/ntms-beacon/beacon_log.csv
NTMS_INPUT=/var/lib/ntms-beacon/beacon_log.csv

# ---- API credentials (from your monitor setup page on prop.w5isp.com) ----
NTMS_MONITOR_TOKEN=your_monitor_key_here
NTMS_BEACON_ID=your_beacon_uuid_here
NTMS_API_URL=https://prop.w5isp.com/api/v1/beacon-monitor/measurements

# ---- Station metadata (sent by reporter) ----------------------------------
NTMS_GRIDSQUARE=FN31pr           # Maidenhead gridsquare
NTMS_ANTENNA_HEIGHT_FT=          # Antenna height in feet (optional)

# ---- Phase filter ----------------------------------------------------------
NTMS_PHASE_FILTER=CARRIER        # Only upload rows matching this phase

# ---- RF / LNB settings ----------------------------------------------------
BEACON_FREQ_MHZ=618.245          # IF center (10368.370 - 9750.000 = 618.370;
                                 #   adjust to match your LNB's actual offset)
BEACON_LO_MHZ=9750.0             # Bullseye LNB low-band LO (no 22 kHz tone)
BEACON_THRESHOLD_DBFS=-50.0      # dBFS level to flag as "detected"
BEACON_PASSBAND_KHZ=5            # ± bandwidth in kHz for signal vs noise separation

# ---- SDR device settings --------------------------------------------------
BEACON_DEVICE=0                  # Device index (0) or serial string (e.g. 00000001)
                                 #   Run: python3 beacon_monitor.py --list-devices
BEACON_GAIN=auto                 # 'auto' or an R820T2 gain step in dB (28.0–38.0
                                 #   is a good starting range for 10 GHz work)
BEACON_PPM=0                     # 0 for TCXO variants (Smart XTR, Smart v5)
                                 # 1 or 2 for standard-crystal NESDR Smart

# ---- Timing ---------------------------------------------------------------
BEACON_INTERVAL_S=10             # Sweep interval in seconds
BEACON_CW_END_S=10               # Seconds into odd minute where CW ends / carrier begins
