[Unit]
Description=NTMS 10 GHz Beacon Monitor
After=network.target
Documentation=https://github.com/North-Texas-Microwave-Society/SDR-based-beacon-receive-systems

[Service]
Type=simple
User=ntms-beacon
Group=ntms-beacon
WorkingDirectory=/var/lib/ntms-beacon
Environment=BEACON_OUTPUT=/var/lib/ntms-beacon/beacon_log.csv
Environment=BEACON_DEVICE=0
Environment=BEACON_FREQ_MHZ=618.245
Environment=BEACON_LO_MHZ=9750.0
Environment=BEACON_THRESHOLD_DBFS=-50.0
Environment=BEACON_PASSBAND_KHZ=5
Environment=BEACON_GAIN=auto
Environment=BEACON_PPM=0
Environment=BEACON_INTERVAL_S=10
Environment=BEACON_CW_END_S=10
ExecStart=/opt/ntms-beacon/venv/bin/python3 /opt/ntms-beacon/beacon_monitor.py
Restart=always
RestartSec=15
StandardOutput=journal
StandardError=journal
SyslogIdentifier=beacon-monitor

[Install]
WantedBy=multi-user.target
