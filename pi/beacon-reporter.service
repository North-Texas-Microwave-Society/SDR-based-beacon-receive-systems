[Unit]
Description=NTMS Beacon Reporter
After=network.target beacon-monitor.service
Wants=beacon-monitor.service
Documentation=https://github.com/North-Texas-Microwave-Society/SDR-based-beacon-receive-systems

[Service]
Type=simple
User=ntms-beacon
Group=ntms-beacon
WorkingDirectory=/var/lib/ntms-beacon
Environment=NTMS_INPUT=/var/lib/ntms-beacon/beacon_log.csv
Environment=NTMS_MONITOR_TOKEN=your_monitor_key_here
Environment=NTMS_BEACON_ID=your_beacon_uuid_here
Environment=NTMS_GRIDSQUARE=
Environment=NTMS_ANTENNA_HEIGHT_FT=
Environment=NTMS_API_URL=https://prop.w5isp.com/api/v1/beacon-monitor/measurements
Environment=NTMS_PHASE_FILTER=CARRIER
ExecStart=/opt/ntms-beacon/venv/bin/python3 /opt/ntms-beacon/beacon_reporter.py --state /var/lib/ntms-beacon/beacon_reporter_state.json
Restart=always
RestartSec=15
StandardOutput=journal
StandardError=journal
SyslogIdentifier=beacon-reporter

[Install]
WantedBy=multi-user.target
